amqp_port: 443
engine:
  type: GlobusComputeEngine
  max_retries_on_system_failure: 1
  max_workers_per_node: 16

  job_status_kwargs:
    max_idletime: 7200

  address:
    type: address_by_interface
    ifname: bond0.2210

  provider:
    type: PBSProProvider
    launcher:
      type: SimpleLauncher
    account: inference_service
    select_options: ngpus=8
    scheduler_options: '#PBS -l filesystems=home:eagle'
    queue: infer-svc
    init_blocks: 0
    max_blocks: 1
    min_blocks: 0
    nodes_per_block: 1
    walltime: 24:00:00
    worker_init: |
      set -euo pipefail

      LOG_DIR="/eagle/inference_service/sam3-service/logs"
      mkdir -p $LOG_DIR
      LOG_FILE="${LOG_DIR}/server_$(hostname)_$$.log"

      # These unused variables are parsed by the inference service
      # (qstat_inference_function) to map the running PBS job to a model:
      model_name="sam3"
      framework="sam3-service"
      cluster="sophia"

      source /eagle/inference_service/sam3-service/.venv/bin/activate

      export SAM3_DIR={{sam3_weights_dir | default("/eagle/inference_service/sam3-service/weights/") }}
      export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
      export HTTPS_PROXY="http://proxy.alcf.anl.gov:3128"
      export http_proxy="http://proxy.alcf.anl.gov:3128"
      export https_proxy="http://proxy.alcf.anl.gov:3128"
      export ftp_proxy="http://proxy.alcf.anl.gov:3128"
      export no_proxy="admin,polaris-adminvm-01,localhost,*.cm.polaris.alcf.anl.gov,polaris-*,*.polaris.alcf.anl.gov,*.alcf.anl.gov"

      nohup uvicorn sam3_service.app:app --host 127.0.0.1 > "$LOG_FILE" 2>&1 &
      SERVER_PID=$!
      echo "Started uvicorn (PID=$SERVER_PID), logging to $LOG_FILE"

      # Poll until the model is loaded or the process dies
      TIMEOUT=300
      ELAPSED=0
      INTERVAL=5

      while ! grep -q "Uvicorn running on http://127.0.0.1:8000" "$LOG_FILE" 2>/dev/null; do
          if ! kill -0 "$SERVER_PID" 2>/dev/null; then
              echo "ERROR: uvicorn (PID=$SERVER_PID) exited before model loaded." >&2
              tail -20 "$LOG_FILE" >&2
              exit 1
          fi
          if (( ELAPSED >= TIMEOUT )); then
              echo "ERROR: Timed out after ${TIMEOUT}s waiting for model load." >&2
              tail -20 "$LOG_FILE" >&2
              exit 1
          fi
          sleep "$INTERVAL"
          (( ELAPSED += INTERVAL ))
      done
      echo "Model loaded successfully (${ELAPSED}s elapsed)."